generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// This describes the "users" table.
// Every employee who can log in (Admin, Sales, Warehouse, Accounts) is a row here.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String // "ADMIN" | "SALES" | "WAREHOUSE" | "ACCOUNTS"
  createdAt    DateTime @default(now())
}

model Customer {
  id           Int        @id @default(autoincrement())
  name         String
  mobile       String
  email        String?
  businessName String?
  gstNumber    String?
  customerType String
  address      String?
  status       String     @default("LEAD")
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  followUps    FollowUp[]
  challans     Challan[]
}

model FollowUp {
  id        Int      @id @default(autoincrement())
  note      String
  createdBy String
  createdAt DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  sku            String          @unique
  category       String?
  unitPrice      Float
  currentStock   Int             @default(0)
  minStockAlert  Int             @default(0)
  location       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  challanItems   ChallanItem[]
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  quantity  Int
  type      String
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  product   Product @relation(fields: [productId], references: [id])
  productId Int
}

model Challan {
  id            Int      @id @default(autoincrement())
  challanNumber String   @unique
  status        String   @default("DRAFT") // "DRAFT" | "CONFIRMED" | "CANCELLED"
  totalQuantity Int      @default(0)
  createdBy     String
  createdAt     DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId Int

  items ChallanItem[]
}

model ChallanItem {
  id       Int @id @default(autoincrement())
  quantity Int

  // --- snapshot fields: frozen at the moment of sale ---
  productName String
  productSku  String
  unitPrice   Float
  // ------------------------------------------------------

  challan   Challan @relation(fields: [challanId], references: [id])
  challanId Int

  product   Product @relation(fields: [productId], references: [id])
  productId Int
}
